/* This settings are for debugging C++ code
 * in Visual Studio Code in Linux environment. */
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Active C++ File",
      "type": "shell",
      "command": "/usr/bin/g++",
      "args": [
        "-g",
        "-O0",
        "-std=c++11",
        "-I${workspaceFolder}",
        "${file}",
        "-o",
        "${workspaceFolder}/${fileBasenameNoExtension}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Build Active C++ File"
    },
    {
      "label": "Build without Debug Active C++ File",
      "type": "shell",
      "command": "/usr/bin/g++",
      "args": [
        "-O2",
        "-std=c++11",
        "-I${workspaceFolder}",
        "${file}",
        "-o",
        "${workspaceFolder}/${fileBasenameNoExtension}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Build without Debug Active C++ File"
    }
  ]
}